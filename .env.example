# API
PORT=3000
NODE_ENV=development

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-system

# Redis
REDIS_URL=redis://localhost:6379

# MongoDB
MONGO_URI=mongodb://localhost:27017/notifications

# Rate limits (tokens per window per channel)
RATE_LIMIT_EMAIL_PER_SEC=50
RATE_LIMIT_SMS_PER_SEC=10
RATE_LIMIT_PUSH_PER_SEC=100

# Retry / backoff
MAX_RETRIES=5
BASE_BACKOFF_MS=1000
MAX_BACKOFF_MS=60000

# Idempotency key TTL (seconds)
IDEMPOTENCY_TTL_SECONDS=86400

# Provider simulation (mock providers fail this % of the time, for demo purposes)
EMAIL_PROVIDER_FAILURE_RATE=0.1
SMS_PROVIDER_FAILURE_RATE=0.15
PUSH_PROVIDER_FAILURE_RATE=0.05

# Circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
