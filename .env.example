# Kafka - note port 9093, not the default 9092 (remapped to avoid
# colliding with the event-platform project's Kafka on this machine)
KAFKA_BROKERS=localhost:9093
KAFKA_CLIENT_ID=notification-system

# Redis - port 6380, not the default 6379
REDIS_URL=redis://localhost:6380

# MongoDB - port 27018, not the default 27017
MONGO_URI=mongodb://localhost:27018/notifications

# How long an idempotency key blocks a duplicate request, in seconds
IDEMPOTENCY_TTL_SECONDS=86400

# Token bucket rate limits, in requests per second, per channel
RATE_LIMIT_EMAIL_PER_SEC=10
RATE_LIMIT_SMS_PER_SEC=5
RATE_LIMIT_PUSH_PER_SEC=20

# Mock provider random failure rate (0-1), so retry/circuit-breaker logic
# has real failures to react to
EMAIL_PROVIDER_FAILURE_RATE=1
SMS_PROVIDER_FAILURE_RATE=0.15
PUSH_PROVIDER_FAILURE_RATE=0.05

# Retry / exponential backoff
MAX_RETRIES=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RATE_LIMIT_RETRY_DELAY_MS=250

# Circuit breaker: consecutive failures before tripping open, and how long
# (ms) it stays open before allowing one half-open trial call through
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MS=5000

# AWS SES - real email sending. Region must match where you verified your
# SES identity (domain/email), not necessarily your IAM user's region (IAM
# is a global service). While your SES account is in sandbox mode, you can
# only send to recipient addresses that are ALSO verified in SES.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
SES_FROM_EMAIL=you@yourdomain.com
