{
  "name": "distributed-notification-system",
  "version": "0.1.0",
  "description": "Learning build of an async multi-channel notification system (Node.js, Kafka, Redis, MongoDB)",
  "main": "src/api/server.js",
  "type": "commonjs",
  "scripts": {
    "setup:topics": "node scripts/createTopics.js",
    "start": "node src/api/server.js",
    "start:worker:email": "node src/workers/emailWorker.js",
    "start:worker:sms": "node src/workers/smsWorker.js",
    "start:worker:push": "node src/workers/pushWorker.js",
    "dlq:view": "node scripts/viewDlq.js",
    "dev:api": "nodemon src/api/server.js",
    "dev:worker:email": "nodemon src/workers/emailWorker.js",
    "dev:worker:sms": "nodemon src/workers/smsWorker.js",
    "dev:worker:push": "nodemon src/workers/pushWorker.js",
    "dev": "concurrently -n api,email,sms,push -c blue,green,yellow,magenta \"npm:dev:api\" \"npm:dev:worker:email\" \"npm:dev:worker:sms\" \"npm:dev:worker:push\"",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.654.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.9.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
